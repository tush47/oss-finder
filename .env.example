# Copy this file to .env.local and fill in the values. .env.local is ignored by git.
#
# Optional. A GitHub token raises the rate limits (10 -> 30 searches per minute,
# 60 -> 5,000 other requests per hour) and enables the "has a contributing guide" filter.
# Create a fine-grained token with "Public repositories (read-only)" access and no other permissions:
# https://github.com/settings/personal-access-tokens/new
#
# Never prefix this with NEXT_PUBLIC_. It must stay on the server.
GITHUB_TOKEN=

